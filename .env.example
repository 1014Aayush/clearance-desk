# ---------------------------------------------------------------------------
# Clearance Desk — environment
# Copy to .env and fill in.  Never commit .env.
# ---------------------------------------------------------------------------

# --- Google Cloud ----------------------------------------------------------
GOOGLE_CLOUD_PROJECT=project-3aa140ee-de59-434f-91f
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# Model used for the multimodal spotting pass over the cut + script.
# Availability is project- and region-specific; verify with:
#   python -m clearance_desk check-models
SPOTTER_MODEL=gemini-2.5-pro
# Cheaper model for drafting outreach copy and prose summaries.
DRAFTER_MODEL=gemini-2.5-flash

# Optional: GCS bucket for uploaded cuts. Files >20MB must go through GCS.
GCS_BUCKET=

# --- Parallel (partner track) ----------------------------------------------
# Get a key at https://platform.parallel.ai
PARALLEL_API_KEY=

# Processor tiers for chain-of-title research.
#   STANDARD — trademarks, locations, print, script references
#   DEEP     — music, archival, clips, artwork (multi-party chains of title)
# See https://docs.parallel.ai/task-api/guides/choose-a-processor
#
# Latency is the tradeoff, and it is large. Measured on this project:
# a single `base` call took ~53s; `pro` runs 2-10 minutes. Every tier has a
# `-fast` variant at the same depth but lower latency — use those for a live
# demo or an interactive UI, and the plain tiers for an overnight batch:
#   PARALLEL_PROCESSOR_STANDARD=core-fast
#   PARALLEL_PROCESSOR_DEEP=pro-fast
PARALLEL_PROCESSOR_STANDARD=core
PARALLEL_PROCESSOR_DEEP=pro
PARALLEL_TIMEOUT_SECONDS=1800

# --- Acoustic identification (optional) ------------------------------------
# Names commercial needle-drops so the research stage has a work to look up.
# Free tier at https://audd.io — 300 requests, no card. $5/1000 after that.
# Leave blank to skip: unnamed cues then block with "supply the cue sheet",
# which is the correct answer for original score in any case.
# Requires ffmpeg on PATH to cut the audio samples.
AUDD_API_TOKEN=

# --- Runtime ---------------------------------------------------------------
# When true, the research layer replays recorded fixtures instead of calling
# Parallel. Useful for offline UI work and deterministic tests.
USE_FIXTURES=false
PORT=8080
